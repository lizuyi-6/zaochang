{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaochang-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // 与 prod 同步:Smart Placement 让 Worker 贴近 D1(APAC)运行,staging 用于
  // 部署前实测该配置的延迟收益(见 wrangler.prod.jsonc 注释)。
  "placement": {
    "mode": "smart"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // staging 独立库(APAC):与生产彻底隔离。dev-login / 旧身份头的 fail-closed
      // 门禁不再依赖 APP_ENV 单点——即便 staging 配置漂移,也伤不到生产数据。
      "database_name": "zaochang-db-staging",
      "database_id": "63f10fae-9667-4f98-9e50-fe58bb402a3c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      // staging 独立 bucket:与生产 zaochang-uploads 彻底隔离,staging 上传扫描
      // 验收写入的对象不会进入生产存储(见 CLOUDFLARE_RUNBOOK §8 与 STAGING_REPORT)。
      "bucket_name": "zaochang-uploads-staging"
    }
  ],
  // 同 wrangler.prod.jsonc:邮箱验证码登录外发(本地 npm test 不受影响——
  // 测试 harness 走 EMAIL_SEND_BASE_URL 假上游,不依赖此 binding)。
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // 过期数据清理(oauth 授权请求/codes/tokens/payments/email codes/auth_sessions):
// 幂等 DELETE,worker/index.ts scheduled() 执行;每 6 小时一次,分钟位错开整点。
  "triggers": {
    "crons": ["23 */6 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // 同 wrangler.prod.jsonc:「问 AI」多模态开关。
    "AI_CHAT_VISION": "1"
  }
}
