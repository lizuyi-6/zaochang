{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaochang-staging",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // 与 prod 同步:Smart Placement 让 Worker 贴近 D1(APAC)运行,staging 用于
  // 部署前实测该配置的延迟收益(见 wrangler.prod.jsonc 注释)。
  "placement": {
    "mode": "smart"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaochang-db",
      "database_id": "d250a527-1e1e-4b7f-ac27-266c723581e3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "zaochang-uploads"
    }
  ],
  // 同 wrangler.prod.jsonc:邮箱验证码登录外发(本地 npm test 不受影响——
  // 测试 harness 走 EMAIL_SEND_BASE_URL 假上游,不依赖此 binding)。
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
