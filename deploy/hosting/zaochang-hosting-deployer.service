[Unit]
Description=Zaochang static hosting deployment worker
After=network.target

[Service]
Type=simple
User=zaochang
Group=zaochang
WorkingDirectory=/opt/zaochang/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/zaochang/hosting.env
Environment=HOME=/var/lib/zaochang/hosting/home
ExecStart=/usr/bin/node /opt/zaochang/current/deploy/hosting/hosting-deployer.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=300
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zaochang/hosting
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=300M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target
