{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaochang",
  "routes": [
    "aetherstudio.top/*",
    "www.aetherstudio.top/*"
  ],
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaochang-db",
      "database_id": "d250a527-1e1e-4b7f-ac27-266c723581e3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "zaochang-uploads"
    }
  ],
  "observability": {
    "enabled": true
  }
}
