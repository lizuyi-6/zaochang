{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaochang",
  "routes": [
    "aetherstudio.top/*",
    "www.aetherstudio.top/*"
  ],
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaochang-db",
      "database_id": "d250a527-1e1e-4b7f-ac27-266c723581e3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "zaochang-uploads"
    }
  ],
  // 邮箱验证码登录的外发通道(CF Email Service)。要求 Workers Paid(已满足)。
  // 发件地址在 app/api/_lib/email-send.ts 固定为 zaochang@aetherstudio.top,
  // 需在 CF 控制台 Email Service 中确认该地址可用(Email Routing 已接管该地址收信)。
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
