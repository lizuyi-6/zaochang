{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaochang",
  "routes": [
    "aetherstudio.top/*",
    "www.aetherstudio.top/*"
  ],
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // Smart Placement:把 Worker 放到 D1(APAC)旁运行。此前 Worker 跑在访客边缘
  // (如 LAX),D1 在 APAC,页面 SSR 的串行 D1 查询每次都要跨洋往返(实测每查询
  // 边际成本 ~1s,bookshelf 2 查询 TTFB 3-4s;cpuTimeP50 仅 12ms,瓶颈全在等待)。
  // 开启后 HTML/动态请求由边缘转发到 APAC 就近查库;静态资源仍走边缘缓存不受影响。
  "placement": {
    "mode": "smart"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zaochang-db",
      "database_id": "d250a527-1e1e-4b7f-ac27-266c723581e3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "zaochang-uploads"
    }
  ],
  // 邮箱验证码登录的外发通道(CF Email Service)。要求 Workers Paid(已满足)。
  // 发件地址在 app/api/_lib/email-send.ts 固定为 zaochang@aetherstudio.top,
  // 需在 CF 控制台 Email Service 中确认该地址可用(Email Routing 已接管该地址收信)。
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // 过期数据清理(oauth 授权请求/codes/tokens/payments/email codes/auth_sessions):
// 幂等 DELETE,worker/index.ts scheduled() 执行;每 6 小时一次,分钟位错开整点。
  "triggers": {
    "crons": ["23 */6 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // 「问 AI」多模态开关:=1 才允许提问附图(内联 base64 直发上游)。上游模型
    // 不支持图像输入时必须保持关闭——路由对带图请求 fail-closed 400。
    "AI_CHAT_VISION": "1"
  }
}
