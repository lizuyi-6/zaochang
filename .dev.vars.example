# 本地开发变量模板(npm run dev / vite 读取)。
# 复制为 .dev.vars 并填入真实值;.dev.vars 已 gitignore,密钥绝不入库/进对话。
#
# Hyperknow 学习 Agent 的 LLM 走 Anthropic Messages 协议({base}/messages),
# 上游必须支持 Messages(如 StepFun step-explore);阅读页「问 AI」共用同一密钥面。
# 缺任一项时对应功能 fail-closed:问 AI 503 ai_not_configured,hyperknow 503。
AI_CHAT_BASE_URL=https://api.stepfun.com/v1
AI_CHAT_API_KEY=填入你的密钥
# 缺省回落 step-explore(阅读 AI 需要;hyperknow 也会回落到它)
AI_CHAT_MODEL=step-explore
# Hyperknow 专属覆盖位(可选):上游与阅读 AI 不同时使用;TTS 缺省即 StepFun step-tts-mini
# HYPERKNOW_AI_BASE_URL=
# HYPERKNOW_AI_API_KEY=
# HYPERKNOW_AI_MODEL=
#
# 课程生成联网研学配置(可选):
# 供应商 HK_WEB_SEARCH_PROVIDER 可选 stepfun / tavily / brave / cloudflare / off。
# 默认优先现有 AI 渠道 (stepfun),复用 AI_CHAT_BASE_URL/API_KEY,使用独立 HK_WEB_SEARCH_MODEL,
# 绝不硬编码官方地址或回退,且 stepfun 忽略 HK_WEB_SEARCH_BASE_URL。
# HK_WEB_SEARCH_PROVIDER=stepfun
# HK_WEB_SEARCH_MODEL=step-3.7-flash
# 外部传统搜索供应商密钥(保留显式配置):
# HK_TAVILY_API_KEY=
# HK_BRAVE_SEARCH_API_KEY=
# HK_SEARCH_ACCOUNT_ID=
# HK_SEARCH_API_TOKEN=
# HK_WEB_SEARCH_BASE_URL=
#
# Hyperknow 白板按需生图 (StepFun 阶跃星辰图像生成):
# 复用 AI_CHAT_BASE_URL / AI_CHAT_API_KEY (自动规范化终端为 images/generations, 绝不回退官方地址)
# 总开关: true / false (默认 true)
# HK_IMAGE_ENABLED=true
# 阶跃生图模型配置: 默认 step-image-edit-2 (官方 2026-10-10 下线旧模型风险)
# HK_IMAGE_MODEL=step-image-edit-2
