<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络:壳本体。相机:扫一扫(getUserMedia 由 onPermissionRequest 只对本站、
         只视频放行;API <33 的 WebView 授权需要 CAMERA 运行时权限背书,不弹系统
         对话框由 WebView 面板呈现)。安装:应用内更新自装的 APK,受系统「安装
         未知应用」门控,首次触发时系统弹授权页。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- API 30+ 包可见性:解析「查看 APK」的安装器 Activity。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Zaochang">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 深链:仅站点本体(未做 assetlinks 验证,系统会弹一次"用哪个应用打开";
                 MainActivity 中仍按主机白名单校验后才加载)。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aetherstudio.top" />
                <data android:scheme="https" android:host="www.aetherstudio.top" />
            </intent-filter>
        </activity>
    </application>
</manifest>
